# All optional. PAID runs with none of these set.

# Server-side RPC for Robinhood Chain (defaults to the public endpoint). Point it at a local fork to rehearse payments.
RPC_URL=

# RPC URL a wallet is given when it has to add the network (defaults to the public endpoint).
NEXT_PUBLIC_RPC_URL=

# LI.FI API key. Without it quotes are rate-limited per IP (roughly a hundred an hour).
LIFI_API_KEY=

# Where the invoice database lives (defaults to ./data; falls back to temp storage on read-only hosts).
PAID_DATA_DIR=
